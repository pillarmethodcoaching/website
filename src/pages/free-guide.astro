---
import Base from '../layouts/Base.astro';
import { APPLY_URL } from '../config';
---
<Base title="Your First 10 Pieces | Pillar Method Coaching" description="Your free style guide from Mitch at The Pillar Method." noindex>
  <div class="page">
    <p class="eyebrow">You're on the list</p>
    <h1>Here's your free guide.</h1>
    <p>Thanks for confirming your email. <strong>Your First 10 Pieces</strong> is yours: the 10 clothes every man should own, how they should fit, and how to wear them together.</p>
    <p style="margin-top:28px"><a class="btn btn-primary" href="/your-first-10-pieces-v4.pdf" download>Download the guide (PDF)</a></p>
    <p style="margin-top:28px">Bookmark this page if you want to come back to it. Ready for more than style? <a href={APPLY_URL}>Apply for a founding spot</a>.</p>
  </div>
</Base>
